@model TaskTracker.Data.Task

@using (Html.BeginForm(
    "Create",
    "Task",
    FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.Hidden(
        "fromHome",
        "true")


    <div class="form-group">

        @Html.LabelFor(model => model.Name)

        @Html.TextBoxFor(
            model => model.Name,
            new
            {
                @class = "form-control",
                required = "required",
                maxlength = "100"
            })

        @Html.ValidationMessageFor(
            model => model.Name,
            "",
            new { @class = "text-danger" })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.Description)

        @Html.TextAreaFor(
            model => model.Description,
            new
            {
                @class = "form-control",
                rows = 4,
                required = "required"
            })

        @Html.ValidationMessageFor(
            model => model.Description,
            "",
            new { @class = "text-danger" })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.MilestoneId)


        @Html.DropDownListFor(
            model => model.MilestoneId,
            (IEnumerable<SelectListItem>)ViewBag.Milestones,
            "-- Select Milestone --",
            new
            {
                @class = "form-control",
                required = "required"
            })

        @Html.ValidationMessageFor(
           model => model.MilestoneId)


    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.Status)

        @Html.DropDownListFor(
            model => model.Status,
            (IEnumerable<SelectListItem>)ViewBag.StatusList,
            "-- Select Status --",
            new
            {
                @class = "form-control",
                required = "required"
            })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.ResponsibleId)

        @Html.DropDownListFor(
            model => model.ResponsibleId,
            (IEnumerable<SelectListItem>)ViewBag.ResponsibleList,
            "-- Select Responsible --",
            new
            {
                @class = "form-control",
                required = "required"
            })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.AssigneeId)

        @Html.DropDownListFor(
            model => model.AssigneeId,
            (IEnumerable<SelectListItem>)ViewBag.AssigneeList,
            "-- Unassigned --",
            new
            {
                @class = "form-control"
            })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.Priority)

        @Html.DropDownListFor(
            model => model.Priority,
            (IEnumerable<SelectListItem>)ViewBag.PriorityList,
            "-- Select Priority --",
            new
            {
                @class = "form-control",
                required = "required"
            })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.DueDate)

        @Html.TextBoxFor(
            model => model.DueDate,
            "{0:yyyy-MM-dd}",
            new
            {
                @class = "form-control",
                type = "date",
                required = "required"
            })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.Comments)

        @Html.TextAreaFor(
            model => model.Comments,
            new
            {
                @class = "form-control",
                rows = 4,
                required = "required"
            })

    </div>


    <br />

    <button type="submit"
            class="btn btn-success btn-block">

        Save Task

    </button>
}