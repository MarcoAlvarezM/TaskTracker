@model IEnumerable<TaskTracker.Data.Project>


@{
    ViewBag.Title = "Task Tracker";
}


<div class="container-fluid">


    <div class="row">


        <!-- CONTENIDO PRINCIPAL -->

        <div class="col-md-9">


            <h2>
                Task Tracker
            </h2>


            <hr />



            @foreach (var project in Model)
            {


                <div class="card project-card">


                    <div class="card-header bg-primary text-white">


                        <h4>
                            @project.Name
                        </h4>


                    </div>



                    <div class="card-body">


                        <p>

                            <strong>Description:</strong>

                            @project.Description

                        </p>


                        <p>

                            <strong>Team:</strong>

                            @project.Team

                        </p>



                        <h5>
                            Milestones
                        </h5>


                        @foreach (var milestone in project.Milestones)
                        {


                            <div class="card milestone-card">


                                <div class="card-header bg-secondary text-white">


                                    <strong>
                                        @milestone.Name
                                    </strong>


                                    <br />

                                    Status:
                                    @(((TaskTracker.Domain.Enums.MilestoneStatus)milestone.Status).ToString())


                                </div>



                                <div class="card-body">


                                    <h6>
                                        Tasks
                                    </h6>



                                    <table class="table table-sm">


                                        <tr>

                                            <th>Name</th>
                                            <th>Status</th>
                                            <th>Responsible</th>
                                            <th>Asignee</th>
                                            <th>Priority</th>
                                            <th>Due Date</th>

                                        </tr>



                                        @foreach (var task in milestone.Tasks)
                                        {


                                            <tr>


                                                <td>

                                                    @task.Name

                                                </td>


                                                <td>

                                                    @(((TaskTracker.Domain.Enums.TaskStatus)task.Status).ToString())

                                                </td>


                                                <td>

                                                    @task.User1.Name

                                                </td>


                                                <td>

                                                    @(task.User != null ? task.User.Name : "Sin asignar")

                                                </td>


                                                <td>

                                                    @(((TaskTracker.Domain.Enums.TaskPriority)task.Priority).ToString())

                                                </td>


                                                <td>

                                                    @task.DueDate

                                                </td>

                                            </tr>


                                        }



                                    </table>


                                </div>


                            </div>


                        }


                    </div>


                </div>



            }



        </div>





        <!-- DRAWER DERECHO -->


        <div class="col-md-3 task-drawer">

            <div class="card">

                <div class="card-header bg-success text-white">

                    <h4>
                        Quick Create
                    </h4>

                </div>


                <div class="card-body">

                    <div class="d-grid gap-2">

                        <button type="button"
                                class="btn btn-success create-btn"
                                data-type="Task">

                            Create Task

                        </button>


                        <button type="button"
                                class="btn btn-secondary create-btn"
                                data-type="Milestone">

                            Create Milestone

                        </button>


                        <button type="button"
                                class="btn btn-primary create-btn"
                                data-type="Project">

                            Create Project

                        </button>

                    </div>


                    <hr />


                    <div id="drawer-content">
                    </div>

                </div>

            </div>

        </div>



    </div>


</div>


@section scripts {

    <script>

        $(document).ready(function () {

            $(".create-btn").click(function () {

                var type = $(this).data("type");

                var controller = type;

                $("#drawer-content").load(
                    "/" + controller + "/Create?partial=true"
                );

            });

        });

    </script>

}