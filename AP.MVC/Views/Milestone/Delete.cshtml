@model TaskTracker.Data.Milestone

@{
    ViewBag.Title = "Delete Milestone";
}

<h2>Delete Milestone</h2>

<h3>Are you sure you want to delete this milestone?</h3>

<hr />

<dl class="dl-horizontal">

    <dt>Project</dt>
    <dd>@Model.Project.Name</dd>

    <dt>Name</dt>
    <dd>@Model.Name</dd>

    <dt>Status</dt>
    <dd>@Model.Status</dd>

</dl>

@using (Html.BeginForm())
{

    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)

    <input type="submit"
           value="Delete"
           class="btn btn-danger" />

    @Html.ActionLink("Cancel",
        "Index",
        null,
        new { @class = "btn btn-secondary" })

}
