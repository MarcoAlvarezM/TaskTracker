@model TaskTracker.Data.Milestone
@using TaskTracker.Domain.Enums

@{
    ViewBag.Title = "Delete Milestone";
}

<h2>Delete Milestone</h2>

<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<dl class="dl-horizontal">

    <dt>Project</dt>
    <dd>@Model.Project.Name</dd>

    <dt>Name</dt>
    <dd>@Model.Name</dd>

    <dt>Status</dt>
    <dd>@((MilestoneStatus)Model.Status)</dd>

</dl>

@if ((bool)ViewBag.HasTasks)
{
    <div class="alert alert-warning">
        This milestone contains tasks and cannot be deleted until all associated tasks are removed.
    </div>

    @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-secondary" })
}
else
{
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.Id)

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        @Html.ActionLink("Cancel",
            "Index",
            null,
            new { @class = "btn btn-secondary" })
    }
}