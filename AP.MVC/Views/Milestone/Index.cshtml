@model IEnumerable<TaskTracker.Data.Milestone>

@{
    ViewBag.Title = "Milestones";
}

<h2>Milestones</h2>

<p>
    @Html.ActionLink("Create New Milestone", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-hover">

    <thead>

        <tr>

            <th>Project</th>
            <th>Name</th>
            <th>Status</th>
            <th width="220"></th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {

            <tr>

                <td>
                    @item.Project.Name
                </td>

                <td>
                    @item.Name
                </td>

                <td>
                    @(((TaskTracker.Domain.Enums.MilestoneStatus)item.Status).ToString())
                </td>

                <td>

                    @Html.ActionLink("Edit", "Edit",
                        new { id = item.Id },
                        new { @class = "btn btn-warning btn-sm" })

                    @Html.ActionLink("Details", "Details",
                        new { id = item.Id },
                        new { @class = "btn btn-info btn-sm" })

                    @Html.ActionLink("Delete", "Delete",
                        new { id = item.Id },
                        new { @class = "btn btn-danger btn-sm" })

                </td>

            </tr>

        }

    </tbody>

</table>