@model TaskTracker.Data.Task

@{
    ViewBag.Title = "Task Details";
}


<h2>Task Details</h2>

<hr />


<dl class="dl-horizontal">


    <dt>Name</dt>
    <dd>@Model.Name</dd>


    <dt>Description</dt>
    <dd>@Model.Description</dd>


    <dt>Milestone</dt>
    <dd>@Model.Milestone.Name</dd>


    <dt>Status</dt>
    <dd>@(((TaskTracker.Domain.Enums.TaskStatus)@Model.Status).ToString())</dd>


    <dt>Created Date</dt>
    <dd>@Model.CreatedDate</dd>


    <dt>Due Date</dt>
    <dd>@Model.DueDate</dd>


    <dt>Modified Date</dt>
    <dd>@Model.ModifiedDate</dd>


    <dt>Responsible</dt>
    <dd>@Model.User1.Name</dd>

    <dt>Assignee</dt>
    <dd>@(Model.User != null ? Model.User.Name : "Sin asignar")</dd>


    <dt>Priority</dt>
    <dd>@(((TaskTracker.Domain.Enums.MilestoneStatus)@Model.Priority).ToString())</dd>


    <dt>Comments</dt>
    <dd>@Model.Comments</dd>


</dl>



<p>

    @Html.ActionLink(
        "Edit",
        "Edit",
        new { id = Model.Id },
        new
        {
            @class = "btn btn-warning"
        })


    @Html.ActionLink(
        "Back",
        "Index",
        null,
        new
        {
            @class = "btn btn-secondary"
        })

</p>