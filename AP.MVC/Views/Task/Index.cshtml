@model IEnumerable<TaskTracker.Data.Task>

@{
    ViewBag.Title = "Tasks";
}

<h2>Tasks</h2>

<p>
    @Html.ActionLink(
        "Create New Task",
        "Create",
        null,
        new { @class = "btn btn-primary" })
</p>


<table class="table table-bordered table-hover">

    <thead>

        <tr>

            <th>Name</th>
            <th>Milestone</th>
            <th>Status</th>
            <th>Responsible</th>
            <th>Priority</th>
            <th>Due Date</th>
            <th></th>

        </tr>

    </thead>


    <tbody>

        @foreach (var item in Model)
        {

            <tr>

                <td>
                    @item.Name
                </td>


                <td>
                    @item.Milestone.Name
                </td>


                <td>
                    @item.Status
                </td>


                <td>
                    @item.Responsible
                </td>


                <td>
                    @item.Priority
                </td>


                <td>
                    @item.DueDate.ToShortDateString()
                </td>


                <td>

                    @Html.ActionLink(
                    "Edit",
                    "Edit",
                    new { id = item.Id },
                    new { @class = "btn btn-warning btn-sm" })


                    @Html.ActionLink(
                    "Details",
                    "Details",
                    new { id = item.Id },
                    new { @class = "btn btn-info btn-sm" })


                    @Html.ActionLink(
                    "Delete",
                    "Delete",
                    new { id = item.Id },
                    new { @class = "btn btn-danger btn-sm" })

                </td>


            </tr>

        }

    </tbody>

</table>