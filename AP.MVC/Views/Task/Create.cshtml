@model TaskTracker.Data.Task

@{
    ViewBag.Title = "Create Task";
}


<h2>Create Task</h2>


@using (Html.BeginForm())
{

    @Html.AntiForgeryToken()


    <div class="form-horizontal">


        <div class="form-group">

            @Html.LabelFor(model => model.Name)

            @Html.TextBoxFor(model => model.Name,
            new
            {
                @class = "form-control",
                required = "required",
                maxlength = "100"
            })

            @Html.ValidationMessageFor(model => model.Name)

        </div>



        <div class="form-group">

            @Html.LabelFor(model => model.Description)

            @Html.TextAreaFor(model => model.Description,
            new
            {
                @class = "form-control",
                rows = 4,
                required = "required"
            })

        </div>



        <div class="form-group">

            @Html.LabelFor(model => model.MilestoneId)


            @Html.DropDownList(
            "MilestoneId",
            null,
            "-- Select Milestone --",
            new
            {
                @class = "form-control",
                required = "required"
            })

        </div>



        <div class="form-group">

            @Html.LabelFor(model => model.Status)

            @Html.TextBoxFor(model => model.Status,
            new
            {
                @class = "form-control",
                required = "required"
            })

        </div>



        <div class="form-group">

            @Html.LabelFor(model => model.CreatedDate)

            @Html.TextBoxFor(
            model => model.CreatedDate,
            "{0:yyyy-MM-dd}",
            new
            {
                @class = "form-control",
            type = "date"
            })

        </div>



        <div class="form-group">

            @Html.LabelFor(model => model.DueDate)

            @Html.TextBoxFor(
            model => model.DueDate,
            "{0:yyyy-MM-dd}",
            new
            {
                @class = "form-control",
                type = "date",
                required = "required"
            })

        </div>



        <div class="form-group">

            @Html.LabelFor(model => model.Responsible)

            @Html.TextBoxFor(model => model.Responsible,
            new
            {
                @class = "form-control",
                required = "required"
            })

        </div>



        <div class="form-group">

            @Html.LabelFor(model => model.Priority)

            @Html.TextBoxFor(model => model.Priority,
            new
            {
                @class = "form-control",
                required = "required"
            })

        </div>



        <div class="form-group">

            @Html.LabelFor(model => model.Comments)

            @Html.TextAreaFor(model => model.Comments,
            new
            {
                @class = "form-control",
                rows = 4,
                required = "required"
            })

        </div>



        <br />

        <input type="submit"
               value="Save"
               class="btn btn-success" />


        @Html.ActionLink(
        "Back",
        "Index",
        null,
        new { @class = "btn btn-secondary" })


    </div>


}


@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        document.querySelector("form").addEventListener("submit", function (e) {

            // Validar Milestone
            var milestone = document.getElementById("MilestoneId");
            if (milestone && milestone.value === "") {
                alert("Select a Milestone.");
                e.preventDefault();
                return;
            }

            // Validar Due Date
            var dueDateInput = document.getElementById("DueDate");

            if (dueDateInput && dueDateInput.value !== "") {

                var dueDate = new Date(dueDateInput.value);
                var today = new Date();

                today.setHours(0, 0, 0, 0);

                if (dueDate < today) {
                    alert("Due Date cannot be earlier than today.");
                    e.preventDefault();
                }
            }

        });
    </script>
}