@model TaskTracker.Data.Task

@{
    ViewBag.Title = "Delete Task";
}


<h2>Delete Task</h2>


<h3>
    Are you sure you want to delete this task?
</h3>


<hr />


<dl class="dl-horizontal">


    <dt>Name</dt>
    <dd>@Model.Name</dd>


    <dt>Milestone</dt>
    <dd>@Model.Milestone.Name</dd>


    <dt>Status</dt>
    <dd>@Model.Status</dd>


    <dt>Responsible</dt>
    <dd>@Model.Responsible</dd>


    <dt>Priority</dt>
    <dd>@Model.Priority</dd>


</dl>



@using (Html.BeginForm())
{

    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)


    <input type="submit"
           value="Delete"
           class="btn btn-danger" />


    @Html.ActionLink(
        "Cancel",
        "Index",
        null,
        new
        {
            @class = "btn btn-secondary"
        })

}