@model TaskTracker.Data.Task
@using System.Web.Mvc

@{
    ViewBag.Title = "Edit Task";
}

<h2>Edit Task</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)


<div class="form-horizontal">


    <div class="form-group">

        @Html.LabelFor(model => model.Name)

        @Html.TextBoxFor(model => model.Name,
        new
        {
            @class = "form-control",
            required = "required",
            maxlength = "100"
        })

        @Html.ValidationMessageFor(model => model.Name)

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.Description)

        @Html.TextAreaFor(model => model.Description,
        new
        {
            @class = "form-control",
            rows = 4,
            required = "required"
        })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.MilestoneId)


        @Html.DropDownListFor(
            model => model.MilestoneId,
            (IEnumerable<SelectListItem>)ViewBag.Milestones,
            "-- Select Milestone --",
            new
            {
                @class = "form-control",
                required = "required"
            })

        @Html.ValidationMessageFor(
           model => model.MilestoneId)


    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.Status)

        @Html.DropDownListFor(
            model => model.Status,
            (IEnumerable<SelectListItem>)ViewBag.StatusList,
            "-- Select Status --",
            new
            {
                @class = "form-control",
                required = "required"
            })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.DueDate)

        @Html.TextBoxFor(
        model => model.DueDate,
        "{0:yyyy-MM-dd}",
        new
        {
            @class = "form-control",
            type = "date",
            required = "required"
        })

    </div>

    @Html.HiddenFor(model => model.CreatedDate)

    <div class="form-group">

        @Html.LabelFor(model => model.ResponsibleId)

        @Html.DropDownListFor(
            model => model.ResponsibleId,
            (IEnumerable<SelectListItem>)ViewBag.ResponsibleList,
            "-- Select Responsible --",
            new
            {
                @class = "form-control",
                required = "required"
            })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.AssigneeId)

        @Html.DropDownListFor(
            model => model.AssigneeId,
            (IEnumerable<SelectListItem>)ViewBag.AssigneeList,
            "-- Unassigned --",
            new
            {
                @class = "form-control"
            })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.Priority)

        @Html.DropDownListFor(
            model => model.Priority,
            (IEnumerable<SelectListItem>)ViewBag.PriorityList,
            "-- Select Priority --",
            new
            {
                @class = "form-control",
                required = "required"
            })

    </div>


    <div class="form-group">

        @Html.LabelFor(model => model.Comments)

        @Html.TextAreaFor(model => model.Comments,
        new
        {
            @class = "form-control",
            rows = 4,
            required = "required"
        })

    </div>


    <br />


    <input type="submit"
           value="Update"
           class="btn btn-warning" />


    @Html.ActionLink(
        "Back",
        "Index",
        null,
        new
        {
            @class = "btn btn-secondary"
        })


</div>

}

@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        document.querySelector("form").addEventListener("submit", function (e) {

            // Validar Milestone
            var milestone = document.getElementById("MilestoneId");
            if (milestone && milestone.value === "") {
                alert("Select a Milestone.");
                e.preventDefault();
                return;
            }

            // Validar Due Date
            var dueDateInput = document.getElementById("DueDate");

            if (dueDateInput && dueDateInput.value !== "") {

                var dueDate = new Date(dueDateInput.value);
                var today = new Date();

                today.setHours(0, 0, 0, 0);

                if (dueDate < today) {
                    alert("Due Date cannot be earlier than today.");
                    e.preventDefault();
                }
            }

        });
    </script>
}