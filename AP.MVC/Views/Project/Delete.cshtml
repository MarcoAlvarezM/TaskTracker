@model TaskTracker.Data.Project

@{
    ViewBag.Title = "Delete Project";
}

<h2>Delete Project</h2>

<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<dl class="dl-horizontal">

    <dt>Name</dt>
    <dd>@Model.Name</dd>

    <dt>Description</dt>
    <dd>@Model.Description</dd>

    <dt>Objective</dt>
    <dd>@Model.Objetive</dd>

    <dt>Team</dt>
    <dd>@Model.Team</dd>

    <dt>Estimated Time</dt>
    <dd>@Model.EstimatedTimeOfCompletion</dd>

</dl>

@if ((bool)ViewBag.HasMilestones)
{
    <div class="alert alert-warning">
        This project contains milestones and cannot be deleted until all associated milestones are removed.
    </div>

    @Html.ActionLink(
        "Back",
        "Index",
        null,
        new { @class = "btn btn-secondary" })
}
else
{
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.ProjectId)

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        @Html.ActionLink(
            "Cancel",
            "Index",
            null,
            new { @class = "btn btn-secondary" })
    }
}