@model TaskTracker.Data.User

@{
    ViewBag.Title = "User Details";
}

<h2>User Details</h2>

<dl class="dl-horizontal">

    <dt>
        Name
    </dt>

    <dd>
        @Model.Name
    </dd>


    <dt>
        Email
    </dt>

    <dd>
        @Model.Email
    </dd>


    <dt>
        Status
    </dt>

    <dd>

        @if (Model.IsActive)
        {
            <span class="text-success">
                Active
            </span>
        }
        else
        {
            <span class="text-danger">
                Inactive
            </span>
        }

    </dd>

</dl>

<p>

    @Html.ActionLink(
        "Edit",
        "Edit",
        new { id = Model.UserId },
        new { @class = "btn btn-warning" })

    @Html.ActionLink(
        "Back",
        "Index",
        null,
        new { @class = "btn btn-secondary" })

</p>
